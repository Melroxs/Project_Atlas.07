{
  "name": "project-atlas-monorepo",
  "private": true,
  "packageManager": "npm@10.9.8",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "start": "npm run start --workspace=project-atlas-api",
    "dev:web": "npm run dev --workspace=web",
    "build:web": "turbo run build --filter=web"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "next": "^15.0.0",
    "prettier": "^3.2.5",
    "turbo": "^2.10.8",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "livekit-client": "^2.21.0"
  }
}
