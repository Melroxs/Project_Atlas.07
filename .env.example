# ==========================================================
# Atlas — Environment Variables
# All variables below are read by the codebase. Set these in
# your host (Vercel / Render / local .env.local) as required.
# ==========================================================

# --- Database (REQUIRED) ---
# PostgreSQL connection string used by the API, web server-side
# routes, and the migration runner.
DATABASE_URL=postgresql://user:password@host:5432/project_atlas

# --- Supabase Auth (REQUIRED) ---
# Web (browser) client keys
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# API / server-side keys
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- Free AI layer (Gemini primary, Groq fallback) ---
# AI_PROVIDER=gemini (default) uses Gemini with Groq fallback;
# AI_PROVIDER=groq uses Groq directly.
GOOGLE_API_KEY=your_google_gemini_api_key
GROQ_API_KEY=your_groq_api_key
AI_PROVIDER=gemini

# --- Atlas Voice (optional) ---
# When ELEMENTAL_API_KEY is unset, Atlas Voice automatically
# falls back to the grounded text explanation provider.
ELEMENTAL_API_KEY=your_elemental_api_key
ELEMENTAL_BASE_URL=https://api.elemental.ai/v1
ELEMENTAL_MODEL=elemental-voice-1

# --- Legacy (optional) - kept for backward compatibility ---
OPENAI_API_KEY=your_openai_api_key

# --- URLs ---
# Public web app URL (used for metadata + canonical URLs)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
# Landing page CTA target
NEXT_PUBLIC_ATLAS_APP_URL=https://your-app.vercel.app
# API base URL used by the web app when calling the Fastify API
NEXT_PUBLIC_API_URL=https://your-api-host/api/v1
# Allowed CORS origins for the API (comma-separated)
CORS_ORIGIN=https://your-app.vercel.app

# --- Server ---
PORT=3000
