# Database
DATABASE_URL=postgresql://user:password@localhost:5432/project_atlas

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Free AI layer (Gemini primary, Groq fallback)
# AI_PROVIDER=gemini (default) uses Gemini with Groq fallback; AI_PROVIDER=groq uses Groq directly.
GOOGLE_API_KEY=your_google_gemini_api_key
GROQ_API_KEY=your_groq_api_key
AI_PROVIDER=gemini

# Legacy (optional) - kept for backward compatibility
OPENAI_API_KEY=your_openai_api_key

# Atlas Application URL (for landing page CTAs)
NEXT_PUBLIC_ATLAS_APP_URL=http://localhost:3000

# API
API_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000

# Server
PORT=3000
